# ==========================================================================
#  SmartPRS — PRODUCTION .env template (Cloud VPS, multi-tenant SaaS)
# --------------------------------------------------------------------------
#  Copy this to `.env` on the live server, fill the REAL values, then run:
#     php artisan key:generate
#     php artisan config:cache route:cache view:cache
#  NEVER commit the filled-in .env. NEVER set APP_DEBUG=true in production.
# ==========================================================================

APP_NAME="SmartPRS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata

# Your real HTTPS domain (no trailing slash). Drives links in emails/invites.
APP_URL=https://app.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Keep logs lean in production; errors still recorded for the daily digest.
LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (create a dedicated MySQL user; do NOT use root in prod) ------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartprs
DB_USERNAME=smartprs
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis: cache, queue, session ------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Production cookies must be HTTPS-only:
SESSION_SECURE_COOKIE=true
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Interim option if you have NOT set up the queue worker yet: switch the line
# above to  QUEUE_CONNECTION=sync  so mail sends inline (no worker needed).
# Upgrade to the redis worker (supervisor) before real load.

# --- Mail: real SMTP. Per-company SMTP is still configurable in-app; this is
#     the platform/tenant-default fallback used by invites, resets, backups,
#     and the error digest. ----------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Ops: backup-failure + daily error-digest recipient --------------------
SMARTPRS_OPS_EMAIL=ops@yourdomain.com

# Optional: password-protect backup zip archives.
# BACKUP_ARCHIVE_PASSWORD=

# --- SmartPRS multi-tenancy ------------------------------------------------
SMARTPRS_DEPLOYMENT=saas
SMARTPRS_DEFAULT_COMPANY_CODE=DEMO

# --- Demo data + first admin (PRODUCTION SAFETY) ---------------------------
# Keep FALSE in production. When false (or APP_ENV=production), `php artisan
# db:seed` creates NO fake tenants/companies/employees and NO shared-password
# logins, and the attendance report NEVER fabricates demo punches. Set true
# only on a throwaway demo box.
SMARTPRS_DEMO_DATA=false
# On a real deploy, db:seed creates ONE platform super admin from these:
SMARTPRS_ADMIN_EMAIL=you@yourdomain.com
SMARTPRS_ADMIN_NAME="Platform Admin"
# Optional: omit to have a strong password generated + printed once during seed.
# SMARTPRS_ADMIN_PASSWORD=

# --- ZKTeco biometric devices (default TCP port 4370) ----------------------
ZKTECO_DEFAULT_PORT=4370
ZKTECO_SYNC_ENABLED=true

# --- SaaS billing: Razorpay (live) -----------------------------------------
# Preferred: set the keys in-app (Billing -> Payment Gateways); secrets are
# encrypted at rest. These env vars are an optional fallback used if no active
# gateway row exists. The WEBHOOK secret is the value Razorpay shows when you
# create the webhook (Dashboard -> Settings -> Webhooks), pointing at:
#     {APP_URL}/webhooks/razorpay     (subscribe to event: payment.captured)
# RAZORPAY_KEY=rzp_live_xxxxxxxxxxxx
# RAZORPAY_SECRET=CHANGE_ME
# RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# --- Seller profile printed on GST tax invoices ----------------------------
# Required for a compliant invoice (esp. GSTIN). GST mode: "inter" => IGST 18%
# (out-of-state customers, the default); "intra" => CGST 9% + SGST 9% (same
# state as the seller).
BILLING_SELLER_NAME="Ametecs India Private Limited"
BILLING_SELLER_GSTIN=36AAHCT0971F1ZB
BILLING_SELLER_ADDRESS="Modern Profound Techpark, Ground Floor, Hive Space, opp. Google, Whitefields, Kondapur, Hyderabad, Telangana, India 500084"
BILLING_SELLER_EMAIL=sales@ametecsindia.com
BILLING_SELLER_PHONE="+91 96666 12424"
BILLING_SELLER_STATE="Telangana (36)"
BILLING_SAC_CODE=998314
BILLING_GST_MODE=inter
