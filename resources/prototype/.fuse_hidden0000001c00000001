const KEY='smartprs_db_v4';
let DB, COMPANY='ALL', CURRENT='platform-dashboard';

function load(){try{DB=JSON.parse(localStorage.getItem(KEY));if(!DB||!DB.employees)throw 0;}catch(e){DB=JSON.parse(JSON.stringify(SEED));}
 // merge any collections present in SEED but missing from stored DB (so new modules always appear)
 try{Object.keys(SEED).forEach(function(k){if(DB[k]===undefined)DB[k]=JSON.parse(JSON.stringify(SEED[k]));});}catch(e){}}
function persist(){try{localStorage.setItem(KEY,JSON.stringify(DB));}catch(e){}}
function addLog(action,entity,detail){DB.activityLogs=DB.activityLogs||[];var now=new Date();var t=now.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'})+', '+now.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'});DB.activityLogs.unshift({id:'LOG-'+Date.now(),time:t,user:'Ejaz Hussain',action:action,entity:entity,detail:detail});try{localStorage.setItem(KEY,JSON.stringify(DB));}catch(e){}}
function resetData(){if(confirm('Reset all data back to the original sample set?')){DB=JSON.parse(JSON.stringify(SEED));persist();render();toast('Data reset to sample');}}
function exportData(){const b=new Blob([JSON.stringify(DB,null,1)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='smartprs-data.json';a.click();toast('Exported smartprs-data.json');}
function importData(inp){const f=inp.files[0];if(!f)return;const r=new FileReader();r.onload=e=>{try{DB=JSON.parse(e.target.result);persist();render();toast('Data imported');}catch(x){alert('Invalid JSON file');}};r.readAsText(f);}

function compName(id){if(id==='ALL')return 'All Companies';const c=DB.companies.find(c=>c.id===id);return c?c.name:id;}
function setCompany(id){COMPANY=id;document.querySelectorAll('#cdrop a').forEach(a=>a.classList.toggle('sel',a.dataset.c===id));document.getElementById('company-name').textContent=compName(id);document.getElementById('company-sub').textContent=id==='ALL'?('Group view · '+DB.companies.length+' entities'):'Legal entity';document.querySelector('#company .cico').textContent=id==='ALL'?'GRP':id.slice(0,3);document.getElementById('company').classList.remove('open');render();}
function inCompany(row){if(COMPANY==='ALL')return true;if(row.companies)return row.companies.includes(COMPANY)||row.companyId===COMPANY;if(row.companyId)return row.companyId===COMPANY||row.companyId==='ALL';return true;}

function fmtMoney(n){n=Number(n)||0;let neg=n<0;n=Math.abs(Math.round(n));let s=''+n;let last3=s.slice(-3);let rest=s.slice(0,-3);if(rest)rest=rest.replace(/\B(?=(\d{2})+(?!\d))/g,',')+',';return (neg?'-':'')+'₹'+rest+last3;}
