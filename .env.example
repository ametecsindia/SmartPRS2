APP_NAME="SmartPRS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (point ONLY at local DB in dev; never reuse old live creds) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartprs
DB_USERNAME=root
DB_PASSWORD=

# --- Cache / queue / session ---
# On-prem SAFE DEFAULTS: file-based, so a fresh install boots WITHOUT Redis and
# the Activation screen can hold a session before any infrastructure is set up.
# (A wrong session driver here 500s the app before the client can even activate.)
# Switch to redis only after Redis is installed and reachable.
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Optional Redis (uncomment + set CACHE_STORE/QUEUE_CONNECTION/SESSION_DRIVER=redis):
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# --- Mail: log locally; real SMTP per company later ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@smartprs.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- SmartPRS multi-tenancy ---
# saas  = multi-tenant hosted; onprem = single-tenant installed licence
SMARTPRS_DEPLOYMENT=saas
SMARTPRS_DEFAULT_COMPANY_CODE=DEMO

# --- ZKTeco biometric devices (default TCP port 4370) ---
ZKTECO_DEFAULT_PORT=4370
ZKTECO_SYNC_ENABLED=true
