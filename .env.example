APP_NAME="SmartPRS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (point ONLY at local DB in dev; never reuse old live creds) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartprs
DB_USERNAME=root
DB_PASSWORD=

# --- Redis: cache, queue, session ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail: log locally; real SMTP per company later ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@smartprs.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- SmartPRS multi-tenancy ---
# saas  = multi-tenant hosted; onprem = single-tenant installed licence
SMARTPRS_DEPLOYMENT=saas
SMARTPRS_DEFAULT_COMPANY_CODE=DEMO

# --- ZKTeco biometric devices (default TCP port 4370) ---
ZKTECO_DEFAULT_PORT=4370
ZKTECO_SYNC_ENABLED=true
